{
  "__inputs": [
    {
      "name": "DS_TEMPO",
      "label": "Tempo",
      "description": "Tempo datasource for traces",
      "type": "datasource",
      "pluginId": "tempo",
      "pluginName": "Tempo"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "tempo", "name": "Tempo", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" },
    { "type": "panel", "id": "nodeGraph", "name": "Node graph", "version": "" }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Traces overview for Google Online Boutique services via Tempo/TraceQL. Filter by $service_name.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "🔍 Trace Health",
      "type": "row"
    },
    {
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.01 }, { "color": "red", "value": 0.05 } ] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "title": "Error Rate (traces/s)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceqlmetrics",
          "query": "{ status = error && resource.service.name = \"$service_name\" } | rate()",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 500000000 }, { "color": "red", "value": 1000000000 } ] },
          "unit": "ns"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "title": "P95 Latency",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceqlmetrics",
          "query": "{ kind = server && resource.service.name = \"$service_name\" } | quantile_over_time(duration, .95)",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1000000000 }, { "color": "red", "value": 2000000000 } ] },
          "unit": "ns"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "title": "P99 Latency",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceqlmetrics",
          "query": "{ kind = server && resource.service.name = \"$service_name\" } | quantile_over_time(duration, .99)",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "title": "Request Rate",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceqlmetrics",
          "query": "{ kind = server && resource.service.name = \"$service_name\" } | rate()",
          "refId": "A"
        }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 200,
      "title": "📊 Error Rate & Latency Over Time",
      "type": "row"
    },
    {
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisLabel": "errors/s", "drawStyle": "line", "fillOpacity": 20, "gradientMode": "scheme", "lineWidth": 2, "pointSize": 5, "showPoints": "auto", "spanNulls": false, "thresholdsStyle": { "mode": "line" } },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.05 } ] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 10,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "title": "Trace Error Rate Over Time",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceqlmetrics",
          "query": "{ status = error && resource.service.name = \"$service_name\" } | rate()",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisLabel": "traces/s", "drawStyle": "bars", "fillOpacity": 80, "gradientMode": "scheme", "lineWidth": 1, "showPoints": "never", "spanNulls": false },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 11,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum", "mean"] }, "tooltip": { "mode": "multi" } },
      "title": "Request Volume Over Time",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceqlmetrics",
          "query": "{ kind = server && resource.service.name = \"$service_name\" } | rate()",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisLabel": "", "drawStyle": "line", "fillOpacity": 10, "gradientMode": "scheme", "lineWidth": 2, "pointSize": 5, "showPoints": "auto", "spanNulls": false },
          "unit": "ns"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 12,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "title": "P95 Latency Over Time",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceqlmetrics",
          "query": "{ kind = server && resource.service.name = \"$service_name\" } | quantile_over_time(duration, .95)",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisLabel": "", "drawStyle": "line", "fillOpacity": 10, "gradientMode": "scheme", "lineWidth": 2, "pointSize": 5, "showPoints": "auto", "spanNulls": false },
          "unit": "ns"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 13,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "title": "P99 Latency Over Time",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceqlmetrics",
          "query": "{ kind = server && resource.service.name = \"$service_name\" } | quantile_over_time(duration, .99)",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "drawStyle": "bars", "fillOpacity": 80, "gradientMode": "scheme", "lineWidth": 1, "showPoints": "never", "spanNulls": false },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "id": 14,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "title": "HTTP 5xx Errors Over Time",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceqlmetrics",
          "query": "{ span.http.status_code >= 500 && resource.service.name = \"$service_name\" } | rate()",
          "refId": "A"
        }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 },
      "id": 300,
      "title": "🗺️ Service Map & Dependency",
      "type": "row"
    },
    {
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 31 },
      "id": 20,
      "options": {},
      "title": "Service Dependency Graph",
      "type": "nodeGraph",
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "serviceMap",
          "refId": "A",
          "serviceMapQuery": "{resource.service.name=\"$service_name\"}"
        }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 41 },
      "id": 400,
      "title": "🔎 Trace Search",
      "type": "row"
    },
    {
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 42 },
      "id": 30,
      "title": "Recent Error Traces",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceql",
          "query": "{ status = error && resource.service.name = \"$service_name\" } | select(resource.service.name, name, duration, span.http.status_code, span.http.url)",
          "limit": 20,
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 42 },
      "id": 31,
      "title": "Slow Traces (> 1s)",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"$service_name\" && duration > 1s } | select(resource.service.name, name, duration, span.http.status_code)",
          "limit": 20,
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 51 },
      "id": 32,
      "title": "Downstream Error Propagation (Structural)",
      "description": "Uses TraceQL structural operator >> to find server spans in this service that have downstream error spans — indicates the error originated from a dependency, not this service itself.",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceql",
          "query": "{ kind = server && resource.service.name = \"$service_name\" } >> { status = error } | select(resource.service.name, name, duration)",
          "limit": 20,
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 51 },
      "id": 33,
      "title": "Traces With Multiple Errors",
      "description": "Traces containing 2 or more error spans — may indicate cascading failures.",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"$service_name\" && status = error } | count() >= 2 | select(resource.service.name, name, duration)",
          "limit": 20,
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["google-boutique", "rca", "aiops", "kagent", "traces-overview"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
        "definition": "",
        "hide": 0,
        "includeAll": false,
        "label": "Service",
        "multi": false,
        "name": "service_name",
        "options": [],
        "query": { "query": "{ kind = server }", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query",
        "queryType": "traceqlmetrics",
        "attributeName": "resource.service.name"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Google Online Boutique — Traces Overview",
  "uid": "traces-overview",
  "version": 1,
  "weekStart": ""
}

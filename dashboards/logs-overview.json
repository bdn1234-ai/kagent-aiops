          "refId": "A",
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "datasource": { "type": "elasticsearch", "uid": "${DS_ELASTICSEARCH}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 50 } ] }
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 32 },
      "id": 22,
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true
      },
      "title": "Error Keywords by Container",
      "type": "bargauge",
      "targets": [
        {
          "datasource": { "type": "elasticsearch", "uid": "${DS_ELASTICSEARCH}" },
          "query": "kubernetes.labels.app:\"$service_name\" AND (message:error OR message:fail OR message:exception OR message:timeout OR message:panic OR message:\"connection refused\" OR message:OOMKilled)",
          "metrics": [ { "type": "count", "id": "1" } ],
          "bucketAggs": [
            {
              "type": "terms",
              "field": "kubernetes.container_name.keyword",
              "id": "2",
              "settings": { "size": "10", "order": "desc", "orderBy": "_count" }
            }
          ],
          "refId": "A",
          "timeField": "@timestamp"
        }
      ]
    },

    {
      "collapsed": false,

      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "elasticsearch", "uid": "${DS_ELASTICSEARCH}" },
          "query": "kubernetes.labels.app:\"$service_name\" AND (message:error OR message:fail OR message:exception OR message:panic OR message:fatal OR log.level:(error OR warn OR warning OR fatal))",
          "metrics": [ { "type": "count", "id": "1" } ],
          "bucketAggs": [
            {
              "type": "date_histogram",
              "field": "@timestamp",
              "id": "2",
              "settings": { "interval": "auto" }
            }
          ],
          "refId": "A",
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "datasource": { "type": "elasticsearch", "uid": "${DS_ELASTICSEARCH}" },

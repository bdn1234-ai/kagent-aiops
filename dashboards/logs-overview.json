      "targets": [
        {
          "datasource": { "type": "elasticsearch", "uid": "${DS_ELASTICSEARCH}" },
          "query": "kubernetes.labels.app:\"$service_name\" AND (message:timeout OR message:\"connection refused\" OR message:\"connection reset\" OR message:\"deadline exceeded\" OR message:\"unavailable\")",
